: ">75", "action": "逐步兑现", "desc": "涨停超 100 家、高度 7 板以上、人人亢奋；一旦出现「跌停增多 + 炸板率回升 + 龙头分歧」，那是顶部信号而非追涨信号。", "color": "#e8590c"}, {"name": "退潮", "range": "快速降温", "action": "空仓防守", "desc": "高度板断层、溢价转负、大面（昨涨停今日跌超 5%）超 10 家，亏钱效应主导；唯一正确的动作是「离场」。", "color": "#8e8e93"}], "metrics": [{"key": "zt", "label": "涨停家数", "group": "核心"}, {"key": "downLimit", "label": "跌停家数", "group": "核心"}, {"key": "sealRate", "label": "封板率", "group": "核心", "unit": "%"}, {"key": "maxLbc", "label": "最高空间板", "group": "核心", "unit": "板"}, {"key": "lianban", "label": "连板家数", "group": "核心"}, {"key": "upRatio", "label": "红盘占比", "group": "核心", "unit": "%"}, {"key": "premiumAvg", "label": "昨涨停溢价", "group": "接力", "unit": "%"}, {"key": "redRatio", "label": "溢价红盘率", "group": "接力", "unit": "%"}, {"key": "damain", "label": "大面家数", "group": "接力"}, {"key": "promo1", "label": "首板晋级率", "group": "接力", "unit": "%"}, {"key": "promo2", "label": "连板晋级率", "group": "接力", "unit": "%"}, {"key": "broken", "label": "炸板家数", "group": "接力"}, {"key": "amount", "label": "两市成交额", "group": "宏观", "unit": "亿"}, {"key": "idxChg", "label": "沪指涨跌", "group": "宏观", "unit": "%"}, {"key": "temp", "label": "情绪温度", "group": "结论"}], "rules": {"formula": "温度 = 涨停家数分(≤30) + 连板高度分(≤20) + 昨日涨停今日溢价分(≤25) + 炸板率分(≤15) + 跌停惩罚(≥-10)", "zt": "≤30家=0 / 30-60=10 / 60-90=18 / 90-120=25 / >120=30", "height": "≤3板=0 / 4-5板=8 / 6-7板=14 / ≥8板=20", "premium": "<-3%=0 / -3~0=8 / 0~2=15 / 2~4=20 / >4%=25", "broken": ">50%=0 / 40-50%=5 / 30-40%=10 / <30%=15", "downLimit": ">50家扣10 / 20-50家扣5 / <20家扣0", "breadth": "涨跌家数对比取东财全市场实时快照（沪市+深市），按日落盘缓存；历史日无快照显示「—」，不做估算", "volume": "两市成交量=沪指+深证综指日K成交量合计（亿手）；成交额取东财指数日K合计（亿元）", "promo": "首板晋级率=昨日首板股今日仍涨停的比例；连板晋级率=昨日连板股今日仍涨停的比例"}, "source": "东方财富涨停池/炸板池/跌停池 + 腾讯/新浪前复权K线（剔除ST与新股）", "fetchedAt": "2026-09-24 16:09:38"}